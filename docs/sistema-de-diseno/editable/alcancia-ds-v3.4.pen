                        24,
                        0
                     ],
                     "stroke" : "$borde",
                     "strokeWidth" : {
                        "bottom" : 3
                     },
                     "type" : "frame",
                     "width" : "fill_container"
                  },
                  {
                     "children" : [
                        {
                           "content" : "Dispositivo · estado antes que configuración",
                           "fill" : "$principal",
                           "fontFamily" : "$ui-font",
                           "fontSize" : 36,
                           "id" : "RlTpK",
                           "lineHeight" : 1.4,
                           "name" : "Dispositivo · estado antes que configuración",
                           "textGrowth" : "fixed-width",
                           "type" : "text",
                           "width" : 570
                        },
                        {
                           "content" : "jBSms: estado recuperable → reintentar → datos del dispositivo → perfil → sesión. Sin conexión no es batería agotada ni pérdida de saldo. Mostrar fecha de última lectura si existe; no inventarla. La confirmación de hardware y los permisos de emparejamiento deben validarse en implementación.",
                           "fill" : "$texto-secundario",
                           "fontFamily" : "$ui-font",
                           "fontSize" : 33,
                           "id" : "qksGz",
                           "lineHeight" : 1.4,
                           "name" : "jBSms: estado recuperable → reintentar → datos del dispositivo → perfil → sesión. Sin conexión no es batería agotada ni pérdida de saldo. Mostrar fecha de última lectura si existe; no inventarla. La confirmación de hardware y los permisos de emparejamiento deben validarse en implementación.",
                           "textGrowth" : "fixed-width",
                           "type" : "text",
                           "width" : "fill_container"
                        }
                     ],
                     "gap" : 48,
                     "id" : "I2xpZ",
                     "name" : "Dispositivo · estado antes que configuración",
                     "padding" : [
                        24,
                        0
                     ],
                     "stroke" : "$borde",
                     "strokeWidth" : {
                        "bottom" : 3
                     },
                     "type" : "frame",
                     "width" : "fill_container"
                  },
                  {
                     "children" : [
                        {
                           "content" : "Cuento · escuchar, conversar y pausar",
                           "fill" : "$principal",
                           "fontFamily" : "$ui-font",
                           "fontSize" : 36,
                           "id" : "omY1j",
                           "lineHeight" : 1.4,
                           "name" : "Cuento · escuchar, conversar y pausar",
                           "textGrowth" : "fixed-width",
                           "type" : "text",
                           "width" : 570
                        },
                        {
                           "content" : "diQk4: tema/paso → título → relato → audio → invitación a conversar → guía o pausa. Una sola acción dominante al pie. No duplicar «preguntas» y «guía» como destinos equivalentes. Ningún audio automático, reproducción completa obligatoria ni aprendizaje inferido.",
                           "fill" : "$texto-secundario",
                           "fontFamily" : "$ui-font",
                           "fontSize" : 33,
                           "id" : "v9avI",
                           "lineHeight" : 1.4,
                           "name" : "diQk4: tema/paso → título → relato → audio → invitación a conversar → guía o pausa. Una sola acción dominante al pie. No duplicar «preguntas» y «guía» como destinos equivalentes. Ningún audio automático, reproducción completa obligatoria ni aprendizaje inferido.",
                           "textGrowth" : "fixed-width",
                           "type" : "text",
                           "width" : "fill_container"
                        }
                     ],
                     "gap" : 48,
                     "id" : "WUczx",
                     "name" : "Cuento · escuchar, conversar y pausar",
                     "padding" : [
                        24,
                        0
                     ],
                     "stroke" : "$borde",
                     "strokeWidth" : {
                        "bottom" : 3
                     },
                     "type" : "frame",
                     "width" : "fill_container"
                  },
                  {
                     "content" : "Subpantallas: usar Volver/Cerrar y omitir la navegación global para no abandonar la tarea accidentalmente. En implementación, el teclado no cubre el importe ni la acción; el contenido puede desplazarse y el pie respeta el safe area. En el canvas, cada ejemplo se muestra completo.",
                     "fill" : "$texto-secundario",
                     "fontFamily" : "$ui-font",
                     "fontSize" : 33,
                     "id" : "o28Ec",
                     "lineHeight" : 1.4,
                     "name" : "Subpantallas: usar Volver/Cerrar y omitir la navegación global para no abandonar la tarea accidentalmente. En implementación, el teclado no cubre el importe ni la acción; el contenido puede desplazarse y el pie respeta el safe area. En el canvas, cada ejemplo se muestra completo.",
                     "textGrowth" : "fixed-width",
                     "type" : "text",
                     "width" : "fill_container"
                  },
                  {
                     "content" : "Contrato de datos: saldo y proyección con moneda; motivo único y destino válido; estado de conexión confirmado con datos fechados; audio con archivo, duración, posición y destino de salida. Acceder a una guía no completa la actividad. La conservación de reproducción al salir requiere validación técnica.",
                     "fill" : "$texto-secundario",
                     "fontFamily" : "$ui-font",
                     "fontSize" : 33,
                     "id" : "ONxzL",
                     "lineHeight" : 1.4,
                     "name" : "Contrato de datos: saldo y proyección con moneda; motivo único y destino válido; estado de conexión confirmado con datos fechados; audio con archivo, duración, posición y destino de salida. Acceder a una guía no completa la actividad. La conservación de reproducción al salir requiere validación técnica.",
                     "textGrowth" : "fixed-width",
                     "type" : "text",
                     "width" : "fill_container"
                  },
                  {
                     "content" : "Checklist adicional: probar importe vacío/cero/inválido; retorno con borrador; destino sin metas; texto de motivo largo; reintento en curso/fallido; datos antiguos o ausentes; audio cargando/error/pausa/fin. Contraste, foco, etiquetas accesibles y áreas ≥ 44 dp. No anunciar cambios no confirmados.",
                     "fill" : "$texto-secundario",
                     "fontFamily" : "$ui-font",
                     "fontSize" : 33,
                     "id" : "hEl4j",
                     "lineHeight" : 1.4,
                     "name" : "Checklist adicional: probar importe vacío/cero/inválido; retorno con borrador; destino sin metas; texto de motivo largo; reintento en curso/fallido; datos antiguos o ausentes; audio cargando/error/pausa/fin. Contraste, foco, etiquetas accesibles y áreas ≥ 44 dp. No anunciar cambios no confirmados.",
                     "textGrowth" : "fixed-width",
                     "type" : "text",
                     "width" : "fill_container"
                  }
               ],
               "fill" : "$base",
               "gap" : 30,
