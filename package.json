{
  "name": "alcancia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "handoff": "vite-node scripts/handoff/build.ts",
    "handoff:capturas": "vite-node scripts/handoff/capturas.ts",
    "front-kit": "vite-node scripts/front-kit/build.ts",
    "front-kit:generar": "vite-node scripts/front-kit/correr-generar.ts",
    "front-kit:verificar": "cd scripts/front-kit/verificar && gradle -q run -PsinGoogleMaven=true --args=\"$PWD/build/capturas\" && gradle -q run -PsinGoogleMaven=true --args=prueba"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.56.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
